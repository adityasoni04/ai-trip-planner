# Firebase  (Console → Project settings → General → Your apps → Web app → SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini (free key from https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=
# Optional: override the model (defaults to gemini-2.5-flash with automatic fallbacks)
# VITE_GEMINI_MODEL=gemini-2.5-flash
